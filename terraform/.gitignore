# Local Terraform directories
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files can contain local account-specific values
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan and package outputs
*tfplan*
*.zip

# CLI configuration
.terraformrc
terraform.rc
