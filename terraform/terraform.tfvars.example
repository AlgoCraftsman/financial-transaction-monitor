# Copy this file to terraform.tfvars for local deployments.
# Do not commit terraform.tfvars.

project_name = "txn-monitor"
environment  = "dev"
aws_region   = "ca-central-1"

lambda_runtime                = "python3.11"
transaction_processor_memory  = 512
transaction_processor_timeout = 30
fraud_detector_memory         = 512
fraud_detector_timeout        = 30
lambda_reserved_concurrency   = -1

log_retention_days  = 30
enable_xray_tracing = true

alarm_period_seconds                     = 300
alarm_evaluation_periods                 = 1
lambda_duration_alarm_threshold_percent  = 80

fraud_risk_threshold          = 75
velocity_check_window_minutes = 60
max_transactions_per_window   = 10
suspicious_amount_threshold   = 1000.00

sqs_max_receive_count  = 3
sqs_visibility_timeout = 180

enable_point_in_time_recovery = false
s3_lifecycle_glacier_days     = 90
s3_lifecycle_expiration_days  = 365

additional_tags = {
  Owner      = "portfolio"
  Workload   = "financial-transaction-monitoring"
  CostCenter = "learning"
}
